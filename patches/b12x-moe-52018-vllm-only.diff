+                tokens=tokens,
+                topk=topk,
+                prepared=prepared,
+                quant_mode=self._quant_mode,
+                apply_router_weight_on_input=apply_router_weight_on_input,
+                swiglu_limit=limit,
+                swiglu_alpha=alpha,
+                swiglu_beta=beta,
+            )
+            signature = (execution_plan.implementation, execution_plan.execution)
+            launch_tokens.setdefault(signature, tokens)
+
