+                max_tokens=key[0],
+                num_topk=key[1],
+                device=prepared.w1_fp4.device,
+                weight_plan=prepared.plan,
+                core_token_counts=(key[0],),
+                route_num_experts=0,
+                quant_mode=self._quant_mode,
+                apply_router_weight_on_input=key[3],
+                swiglu_limit=limit,
+                swiglu_alpha=alpha,
+                swiglu_beta=beta,
