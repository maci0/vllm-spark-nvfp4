# NVFP4 KV cache for DeepSeek-V4 on the eugr b12x image.
#
# PROVENANCE
#   base    ghcr.io/spark-arena/dgx-vllm-eugr-nightly-b12x:2026081903
#           (eugr/spark-vllm-docker nightly, vLLM dev20003, b12x SM120 kernels,
#           DSpark speculative decoding)
#   patch   eugr-nvfp4.patch, 71 lines across 3 files, generated by diffing the
#           base image's installed vllm tree against a patched copy
#
# WHY THIS IS SMALL
#   The eugr tree already carries nvfp4_ds_mla through the generic MLA stack
#   (mla.py, mla_cache_format.py, mla_attention.py, b12x_mla_sparse.py,
#   _custom_ops.py) and already classifies it as KVQuantMode.NVFP4. Only the
#   deepseek_v4 module hardcodes fp8, so the patch is confined to that and to
#   the two page-size specs the DSv4 path feeds.
#
# WHAT IT CHANGES
#   1. config/vllm.py            the nvfp4-with-MLA guard used startswith(),
#                                which also caught the padded nvfp4_ds_mla
#   2. deepseek_v4/attention.py  the DSv4 dtype resolver now returns the padded
#                                uint8 layout for nvfp4_ds_mla
#   3. page alignment            584B envelope on the main KV and sliding-window
#                                caches only; the indexer and compressor caches
#                                deliberately keep upstream 576/512
#   4. sparse_swa.py             get_kv_cache_shape must recognise nvfp4_ds_mla,
#                                or the allocator builds a 512-wide cache and
#                                FlashInfer rejects it at the first decode
#
#   The alignment split (which caches get 584 and which do not) is copied from
#   ghcr.io/anemll/dspark-vllm-gx10:0.1.1, which serves NVFP4 KV on this
#   hardware. It is not inferred.

FROM ghcr.io/spark-arena/dgx-vllm-eugr-nightly-b12x:2026081903

COPY eugr-nvfp4.patch /tmp/eugr-nvfp4.patch
RUN patch -p1 -d /usr/local/lib/python3.12/dist-packages --forward \
        < /tmp/eugr-nvfp4.patch \
    && rm -f /tmp/eugr-nvfp4.patch

# A clean `patch` exit does not prove the dtype is reachable, and every failure
# mode here costs a full two-node model load (~8 min) before it shows up. Assert
# behaviour at build time instead.
RUN python3 - <<'PY'
import torch
from vllm.config.cache import CacheDType
from vllm.v1.kv_cache_interface import KVQuantMode, get_kv_quant_mode
from vllm.v1.attention.backends.mla.sparse_swa import DeepseekSparseSWABackend
from vllm.models.deepseek_v4 import attention as a

opts = getattr(CacheDType, "__args__", ())
assert "nvfp4_ds_mla" in opts, f"nvfp4_ds_mla not an accepted --kv-cache-dtype: {opts}"

# Gate 2: the DSv4 resolver must hand back the padded uint8 layout.
assert a._resolve_dsv4_kv_cache_dtype(True, "nvfp4_ds_mla", None) == (
    "nvfp4_ds_mla",
    torch.uint8,
), "DSv4 resolver did not accept nvfp4_ds_mla"
# No regression for the fp8 layout this image ships with.
assert a._resolve_dsv4_kv_cache_dtype(True, "fp8_ds_mla", None) == (
    "fp8_ds_mla",
    torch.uint8,
), "fp8_ds_mla layout regressed"

# If the quant mode is NONE the KV allocator passes "auto" to get_kv_cache_shape
# and silently drops the packed layout.
assert get_kv_quant_mode("nvfp4_ds_mla") == KVQuantMode.NVFP4, (
    "nvfp4_ds_mla must classify as NVFP4 or the allocator ignores the packed layout"
)
assert DeepseekSparseSWABackend.get_kv_cache_shape(
    1, 64, 1, 512, cache_dtype_str="nvfp4_ds_mla"
) == (1, 64, 584), "SWA cache shape is not the 584B packed envelope"
assert DeepseekSparseSWABackend.get_kv_cache_shape(
    1, 64, 1, 512, cache_dtype_str="fp8_ds_mla"
) == (1, 64, 584), "fp8_ds_mla SWA cache shape regressed"

# The invariant this patch rests on: nvfp4_ds_mla is the same paged envelope as
# fp8_ds_mla and differs only in element encoding, so every layout calculation
# must agree between the two. When they disagree, the page-size math and tensor
# shape describe different objects and sub-tensor pointers fall off 16-byte
# boundaries ("Tensor data pointer is not aligned to 16 bytes") during the
# forward pass, long after the cache has been allocated.
from vllm.v1.kv_cache_interface import SlidingWindowMLASpec


def _swa_page(dtype_str):
    return SlidingWindowMLASpec(
        block_size=64,
        num_kv_heads=1,
        head_size=512,
        head_size_v=512,
        dtype=torch.uint8,
        sliding_window=2048,
        cache_dtype_str=dtype_str,
        alignment=576,
        model_version="deepseek_v4",
        kv_quant_mode=get_kv_quant_mode(dtype_str),
    ).page_size_bytes


assert _swa_page("nvfp4_ds_mla") == _swa_page("fp8_ds_mla"), (
    f"page size diverges: nvfp4_ds_mla={_swa_page('nvfp4_ds_mla')} "
    f"fp8_ds_mla={_swa_page('fp8_ds_mla')}; nvfp4_ds_mla must not take the "
    "generic per-head NVFP4 layout"
)

print("image OK: nvfp4_ds_mla resolves, classifies as NVFP4, 584B envelope wired")
PY

LABEL org.opencontainers.image.title="vllm-spark-eugr-nvfp4"
LABEL org.opencontainers.image.description="eugr b12x nightly with nvfp4_ds_mla KV enabled for DeepSeek-V4"
LABEL org.opencontainers.image.base.name="ghcr.io/spark-arena/dgx-vllm-eugr-nightly-b12x:2026081903"
